{
  "name": "freedomtalk",
  "version": "0.1.0",
  "description": "Discord clone - Open source communication platform",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "npm run type-check --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "backup:db": "npm run backup:db --workspace=@freedomtalk/scripts",
    "restore:db": "npm run restore:db --workspace=@freedomtalk/scripts",
    "backup:list": "npm run backup:list --workspace=@freedomtalk/scripts",
    "test": "SKIP_RATE_LIMIT=true npx playwright test",
    "test:api": "SKIP_RATE_LIMIT=true npx playwright test --project=api",
    "test:e2e": "SKIP_RATE_LIMIT=true npx playwright test --project=e2e-chromium",
    "test:ui": "SKIP_RATE_LIMIT=true npx playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.10.5",
    "playwright": "^1.58.2",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/freedomtalk.git"
  },
  "keywords": [
    "discord",
    "chat",
    "communication",
    "real-time",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/swagger-ui": "6.1.1",
    "@vitest/ui": "5.0.3",
    "minio": "^7.0.16",
    "next": "16.4.0",
    "nodemailer": "10.0.15",
    "sharp": "0.35.5",
    "vitest": "5.0.3"
  }
}
