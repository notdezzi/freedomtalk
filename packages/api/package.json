{
  "name": "@freedomtalk/api",
  "version": "0.1.0",
  "description": "FreedomTalk API - Backend server with Fastify",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "migrate:make": "knex migrate:make --knexfile knexfile.ts -x ts",
    "migrate:latest": "knex migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.ts",
    "migrate:status": "knex migrate:status --knexfile knexfile.ts",
    "migrate:list": "knex migrate:list --knexfile knexfile.ts",
    "seed:make": "knex seed:make --knexfile knexfile.ts -x ts",
    "seed:run": "knex seed:run --knexfile knexfile.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/knex": "^0.15.2",
    "@types/qrcode": "^1.5.6",
    "@types/socket.io": "^3.0.1",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.3",
    "@vitest/ui": "^1.6.1",
    "bcrypt": "^5.1.1",
    "dotenv": "^17.3.1",
    "fastify": "^5.2.1",
    "highlight.js": "^11.11.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "marked": "^12.0.2",
    "mediasoup": "^3.19.17",
    "meilisearch": "^0.55.0",
    "minio": "^8.0.6",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.1",
    "open-graph-scraper": "^6.11.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "redis": "^4.7.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "speakeasy": "^2.0.0",
    "supertest": "^6.3.4",
    "uuid": "^13.0.0",
    "vitest": "^1.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/marked": "^5.0.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^7.0.10",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
